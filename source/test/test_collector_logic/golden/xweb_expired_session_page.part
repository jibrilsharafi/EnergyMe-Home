		<div id="login-screen">
			<img id="login-logo" src="img/xweb-logo.png" style="display: none">
			<!--<progress id="login-progress" min="0" max="100"></progress>-->
			<p id="login-sysname" class="align-center" style="display: none"></p>
			<p id="login-error" style="display: none"></p>
