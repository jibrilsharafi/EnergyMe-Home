				<input id="login-password" type="password" placeholder="password" class="input" required>
				<select id="login-language" class="select"></select>
				<button id="login-button" class="button">Login</button>
			</form>
			<time id="login-date" style="color: rgba(0, 0, 0, 0.5)"></time>
